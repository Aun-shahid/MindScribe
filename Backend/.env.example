# Django Configuration
DJANGO_SECRET_KEY=your-secret-key-here-change-this-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,*.localhost

# Database Configuration (PostgreSQL)
DB_NAME=MindScribe
DB_USER=postgres
DB_PASSWORD=your-password-here
DB_HOST=localhost
DB_PORT=5432

# Authentication Settings
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=900
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=900
SESSION_TIMEOUT=3600

# Email Configuration (for development - using console backend)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@MindScribe.com

# Redis Configuration
REDIS_URL=redis://127.0.0.1:6379/1

# Frontend Configuration
FRONTEND_URL=http://localhost:3000

# Site Configuration
SITE_NAME=MindScribe
VERSION=1.0.0

# Security (for development)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False