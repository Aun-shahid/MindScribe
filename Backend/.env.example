# Django Configuration
DJANGO_SECRET_KEY=your-secret-key-here-change-this-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,*.localhost
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=https://*.railway.app,http://localhost:3000,http://127.0.0.1:3000

# Database Configuration (PostgreSQL)
DB_NAME=MindScribe
DB_USER=postgres
DB_PASSWORD=your-password-here
DB_HOST=localhost
DB_PORT=5432

# Authentication Settings
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=900
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=900
SESSION_TIMEOUT=3600

# Email Configuration (for development - using console backend)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
RESEND_API_KEY=
EMAIL_FROM=info@mindscribe.live
DEFAULT_FROM_EMAIL=info@mindscribe.live

# Redis Configuration
REDIS_URL=redis://127.0.0.1:6379/1

# Process role for start.sh (web)
PROCESS_TYPE=web

# Reminder Matching Windows
DAILY_REMINDER_WINDOW_MINUTES=5
SESSION_REMINDER_WINDOW_MINUTES=10

# In-app scheduler interval in seconds (valid range: 10-60)
IN_APP_REMINDER_SCHEDULER_INTERVAL_SECONDS=10

# Optional: disable in-app scheduler process-wide
DISABLE_IN_APP_REMINDER_SCHEDULER=false

# Frontend Configuration
FRONTEND_URL=http://localhost:3000

# Public origin of this API (no trailing slash). Required for correct avatar_url and media URLs
# in API responses. In production use your real API base URL, e.g. https://api.example.com
BACKEND_URL=http://localhost:8000

# Site Configuration
SITE_NAME=MindScribe
VERSION=1.0.0

# Security (for development)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Production overrides (recommended)
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=.railway.app,your-api-domain.com
# CORS_ALLOW_ALL_ORIGINS=False
# CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com
# CSRF_TRUSTED_ORIGINS=https://your-frontend-domain.com,https://*.railway.app
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True