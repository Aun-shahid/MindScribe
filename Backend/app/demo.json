    {
        "model": "transcription.transcriptionsegment",
        "pk": 1,
        "fields": {
            "transcription": "058693ad-f154-4e2b-ad90-e101897acbfb",
            "speaker_type": "therapist",
            "text": "Hello, how are you feeling today?",
            "start_time": 0.0,
            "end_time": 3.0,
            "confidence_score": 0.96
        }
    },
    {
        "model": "transcription.transcriptionsegment",
        "pk": 2,
        "fields": {
            "transcription": "058693ad-f154-4e2b-ad90-e101897acbfb",
            "speaker_type": "patient",
            "text": "A bit overwhelmed, to be honest. Work has been piling up.",
            "start_time": 4.2,
            "end_time": 9.2,
            "confidence_score": 0.96
        }
    },
    {
        "model": "transcription.transcriptionsegment",
        "pk": 3,
        "fields": {
            "transcription": "058693ad-f154-4e2b-ad90-e101897acbfb",
            "speaker_type": "therapist",
            "text": "I hear you. When you say overwhelming, what specific part of work feels that way?",
            "start_time": 10.4,
            "end_time": 16.4,
            "confidence_score": 0.96
        }
    },
    {
        "model": "transcription.transcriptionsegment",
        "pk": 4,
        "fields": {
            "transcription": "058693ad-f154-4e2b-ad90-e101897acbfb",
            "speaker_type": "patient",
            "text": "It's mostly the new project deadlines. They feel impossible to meet.",
            "start_time": 17.6,
            "end_time": 23.6,
            "confidence_score": 0.96
        }
    },
    {
        "model": "transcription.transcriptionsegment",
        "pk": 5,
        "fields": {
            "transcription": "058693ad-f154-4e2b-ad90-e101897acbfb",
            "speaker_type": "therapist",
            "text": "Let's break them down together. Have you tried making a prioritized list?",
            "start_time": 24.8,
            "end_time": 29.8,
            "confidence_score": 0.96
        }
    },
    {
        "model": "transcription.transcriptionsegment",
        "pk": 6,
        "fields": {
            "transcription": "058693ad-f154-4e2b-ad90-e101897acbfb",
            "speaker_type": "patient",
            "text": "Not yet. I just get frozen when I look at all of it at once.",
            "start_time": 31.0,
            "end_time": 36.0,
            "confidence_score": 0.96
        }
    },
    {
        "model": "transcription.transcriptionsegment",
        "pk": 7,
        "fields": {
            "transcription": "058693ad-f154-4e2b-ad90-e101897acbfb",
            "speaker_type": "therapist",
            "text": "That's a common reaction. What if we focus on just the very first step?",
            "start_time": 37.2,
            "end_time": 42.2,
            "confidence_score": 0.96
        }
    },
    {
        "model": "transcription.transcriptionsegment",
        "pk": 8,
        "fields": {
            "transcription": "058693ad-f154-4e2b-ad90-e101897acbfb",
            "speaker_type": "patient",
            "text": "That... actually sounds more manageable. I could probably do that.",
            "start_time": 43.400000000000006,
            "end_time": 48.400000000000006,
            "confidence_score": 0.96
        }
    },
    {
        "model": "transcription.transcriptionsegment",
        "pk": 9,
        "fields": {
            "transcription": "12eda5bf-9290-42d0-8a2b-89d837807fae",
            "speaker_type": "therapist",
            "text": "Welcome back. How did the prioritizing exercise go this week?",
            "start_time": 0.0,
            "end_time": 4.0,
            "confidence_score": 0.96
        }
    },
    {
        "model": "transcription.transcriptionsegment",
        "pk": 10,
        "fields": {
            "transcription": "12eda5bf-9290-42d0-8a2b-89d837807fae",
            "speaker_type": "patient",
            "text": "It went surprisingly well. I actually got the first two tasks done.",
            "start_time": 5.2,
            "end_time": 10.2,
            "confidence_score": 0.96
        }
    },
    {
        "model": "transcription.transcriptionsegment",
        "pk": 11,
        "fields": {
            "transcription": "12eda5bf-9290-42d0-8a2b-89d837807fae",
            "speaker_type": "therapist",
            "text": "That's fantastic progress! How did it feel when you crossed them off?",
            "start_time": 11.4,
            "end_time": 16.4,
            "confidence_score": 0.96
        }
    },
    {
        "model": "transcription.transcriptionsegment",
        "pk": 12,
        "fields": {
            "transcription": "12eda5bf-9290-42d0-8a2b-89d837807fae",
            "speaker_type": "patient",
            "text": "Really relieving. Like a huge weight was lifted off my shoulders.",
            "start_time": 17.6,
            "end_time": 23.6,
            "confidence_score": 0.96
        }
    },
    {
        "model": "transcription.transcriptionsegment",
        "pk": 13,
        "fields": {
            "transcription": "12eda5bf-9290-42d0-8a2b-89d837807fae",
            "speaker_type": "therapist",
            "text": "Great! Did you face any moments where the anxiety returned?",
            "start_time": 24.8,
            "end_time": 28.8,
            "confidence_score": 0.96
        }
    },
    {
        "model": "transcription.transcriptionsegment",
        "pk": 14,
        "fields": {
            "transcription": "12eda5bf-9290-42d0-8a2b-89d837807fae",
            "speaker_type": "patient",
            "text": "A little bit on Wednesday, but I remembered to focus on just one thing.",
            "start_time": 30.0,
            "end_time": 36.0,
            "confidence_score": 0.96
        }
    },
    {
        "model": "transcription.transcriptionsegment",
        "pk": 15,
        "fields": {
            "transcription": "6e5d9834-0672-41f2-92c2-5cf047551236",
            "speaker_type": "therapist",
            "text": "It's good to see you again. Where would you like to start today?",
            "start_time": 0.0,
            "end_time": 4.0,
            "confidence_score": 0.96
        }
    },
    {
